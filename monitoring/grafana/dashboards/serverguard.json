{
  "title": "ServerGuard",
  "uid": "serverguard",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "type": "gauge", "title": "CPU %", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100,
       "thresholds": {"mode": "absolute", "steps": [
         {"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 85}]}}, "overrides": []},
     "targets": [{"refId": "A", "expr": "serverguard_cpu_usage_percent"}]},
    {"id": 2, "type": "gauge", "title": "Memory %", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100,
       "thresholds": {"mode": "absolute", "steps": [
         {"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}]}}, "overrides": []},
     "targets": [{"refId": "A", "expr": "serverguard_memory_usage_percent"}]},
    {"id": 3, "type": "gauge", "title": "Disk %", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100,
       "thresholds": {"mode": "absolute", "steps": [
         {"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []},
     "targets": [{"refId": "A", "expr": "serverguard_disk_usage_percent"}]},
    {"id": 4, "type": "stat", "title": "Open alerts (critical)", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "serverguard_active_alerts{severity=\"CRITICAL\"}"}]},
    {"id": 5, "type": "timeseries", "title": "CPU and memory %", "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
     "targets": [
       {"refId": "A", "expr": "serverguard_cpu_usage_percent", "legendFormat": "CPU"},
       {"refId": "B", "expr": "serverguard_memory_usage_percent", "legendFormat": "Memory"}]},
    {"id": 6, "type": "timeseries", "title": "Network speed", "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
     "targets": [
       {"refId": "A", "expr": "serverguard_network_download_bytes_per_second", "legendFormat": "Download"},
       {"refId": "B", "expr": "serverguard_network_upload_bytes_per_second", "legendFormat": "Upload"}]},
    {"id": 7, "type": "stat", "title": "Service status (1 = up)", "gridPos": {"x": 0, "y": 14, "w": 12, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {
         "0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}, "overrides": []},
     "targets": [{"refId": "A", "expr": "serverguard_service_up", "legendFormat": "{{service}}"}]},
    {"id": 8, "type": "timeseries", "title": "Recovery attempts", "gridPos": {"x": 12, "y": 14, "w": 12, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "serverguard_recovery_attempts_total", "legendFormat": "{{result}}"}]}
  ]
}
